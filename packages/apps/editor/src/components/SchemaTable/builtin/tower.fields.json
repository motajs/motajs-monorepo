      "title": "开启加点",
      "editor": {
        "kind": "checkbox"
      }
    },
    "tower.flag.enableNegativeDamage": {
      "type": "boolean",
      "title": "开启负伤",
      "editor": {
        "kind": "checkbox"
      }
    },
    "tower.flag.betweenAttackMax": {
      "type": "boolean",
      "title": "夹击不超伤害值",
      "editor": {
        "kind": "checkbox"
      }
    },
    "tower.flag.useLoop": {
      "type": "boolean",
      "title": "二分临界",
      "editor": {
        "kind": "checkbox"
      }
    },
    "tower.flag.startUsingCanvas": {
      "type": "boolean",
      "title": "标题开启事件化",
      "editor": {
        "kind": "checkbox"
      }
    },
    "tower.flag.enableEnemyPoint": {
      "type": "boolean",
      "title": "定点怪显",
      "editor": {
        "kind": "checkbox"
      }
    },
    "tower.flag.enableGentleClick": {
      "type": "boolean",
