      "title": "虚化前景层",
      "editor": {
        "kind": "checkbox"
      }
    },
    "tower.style.startBackground": {
      "type": "string",
      "title": "横屏标题背景",
      "editor": {
        "kind": "text"
      }
    },
    "tower.style.startVerticalBackground": {
      "type": "string",
      "title": "竖屏标题背景",
      "editor": {
        "kind": "text"
      }
    },
    "tower.style.startLogoStyle": {
      "type": "string",
      "title": "标题样式",
      "editor": {
        "kind": "text"
      }
    },
    "tower.style.startButtonsStyle": {
      "type": "string",
      "title": "标题按钮样式",
