      "editor": {
        "kind": "checkbox"
      }
    },
    "tower.flag.enableRouteFolding": {
      "type": "boolean",
      "title": "录像折叠",
      "editor": {
        "kind": "checkbox"
      }
    },
    "tower.flag.disableShopOnDamage": {
